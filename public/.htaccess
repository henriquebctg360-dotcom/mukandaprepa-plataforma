# MUKANDA PREPA — configuração do Apache no cPanel.
# Este ficheiro vai para dentro de dist/ e é publicado com o site.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forcar HTTPS e fixar o endereco com www.
  #
  # Sem isto o site respondia tambem em http://, sem encriptacao, e os
  # navegadores avisavam que a ligacao nao era segura. O certificado sempre
  # esteve bom — faltava mandar quem chega por http passar para https.
  #
  # As duas regras sao limitadas ao dominio principal de proposito: o Apache
  # tambem le este ficheiro quando serve api.mukandaprepa.com e
  # app.mukandaprepa.com, cujas pastas vivem dentro de public_html. Sem este
  # cuidado, os dois subdominios eram atirados para o site institucional.

  RewriteCond %{HTTP_HOST} ^(www\.)?mukandaprepa\.com$ [NC]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://www.mukandaprepa.com%{REQUEST_URI} [R=301,L]

  RewriteCond %{HTTP_HOST} ^mukandaprepa\.com$ [NC]
  RewriteRule ^ https://www.mukandaprepa.com%{REQUEST_URI} [R=301,L]

  # Um ficheiro que falta devolve 404 e nao o index.html.
  #
  # Isto apanhou-nos a serio. Durante a publicacao o index.html novo chega
  # antes dos ficheiros assets/. Nesse intervalo o pedido do JavaScript novo
  # caia na regra das rotas e recebia o index.html — com 200 e com a cache de
  # um ano dos ficheiros versionados. O navegador guardava HTML debaixo do
  # endereco do JavaScript e so o largava um ano depois.
  #
  # Com esta regra, um ficheiro que ainda nao chegou da 404: o navegador nao
  # guarda nada e, assim que o ficheiro chega, carrega-o. A publicacao tambem
  # passou a enviar o index.html em ultimo lugar, por isso o intervalo deixou
  # de existir — mas a rede de seguranca fica.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(assets/|fontes/) - [R=404,L]

  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule \.(html?|js|css|woff2?|map|json|xml|txt|png|jpe?g|webp|svg|ico)$ - [R=404,L]

  # Rotas do React: o que nao for ficheiro nem pasta vai para o index.html.
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache (ESP-41).
#
# A regra anterior dava um ano de cache "immutable" a TODOS os ficheiros com
# extensao de ficheiro estatico. Para o que o Vite gera em assets/ isso esta
# certo: o nome traz o resumo do conteudo, por isso mudar o conteudo muda o
# nome e o navegador vai buscar outro ficheiro.
#
# Para os ficheiros de public/ esta errado, e a diferenca nao e teorica: o
# og-mukandaprepa.png, o logo-icon.png, os icones e o sitemap.xml tem nome
# FIXO. Dizer "immutable, um ano" a um nome fixo e prometer que o conteudo
# nunca muda — e quando muda, quem ja o tinha fica com o antigo durante um
# ano, sem maneira de o forcar a ir buscar outra vez.
#
# Apanhado a 14 Nov 2026, ao trocar a imagem de partilha.
<IfModule mod_headers.c>
  # Nome versionado: um ano, e nunca mais se pergunta.
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Nome fixo: um dia de cache, e depois pergunta-se ao servidor se mudou.
  # O servidor responde "nao mudou" em poucos bytes quando nao mudou, por
  # isso isto nao pesa na velocidade.
  <FilesMatch "\.(png|jpe?g|webp|svg|ico|xml|txt)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>

  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Nota: hoje NENHUMA imagem tem nome versionado — as 40 estao em public/ com
# nome fixo, e o Vite so versiona o js e o css. Se um dia passarem pelo Vite,
# acrescenta-se aqui uma regra para elas. Nao se deixa uma regra a adivinhar
# nomes versionados: bastava um ficheiro chamar-se algo-12345678.png para
# apanhar um ano de cache sem ninguem querer.

# Compressão. Sem isto o navegador descarrega o triplo em texto.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml application/xml
</IfModule>

# O mesmo pela via do mod_expires, para os servidores que leiam este e nao
# o mod_headers. As fontes ficam com o ano; as imagens com o dia, pela razao
# explicada acima.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 1 day"
  ExpiresByType image/png "access plus 1 day"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
